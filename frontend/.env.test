# backend service base url, test environment (local Spring Boot backend)
# NOTE: must include the /api/v1 prefix — frontend request urls are '/auth/login' etc.
# In dev (`pnpm dev` runs `vite --mode test`) this value is also used as the
# `/proxy-default` proxy target; http-proxy prepends the target path automatically.
VITE_SERVICE_BASE_URL=http://localhost:8080/api/v1

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{}`
